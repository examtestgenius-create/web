function runDownloadBatch(){return lock('download',()=>{const s=tab(APP.Q,QH),batch=objects(s).filter(x=>['VALIDATED','DOWNLOAD_PENDING','DOWNLOAD_FAILED'].includes(String(x.status))).slice(0,Number(props().getProperty('DL_BATCH_SIZE')||10));let ok=0,fail=0;batch.forEach(r=>{try{const root=DriveApp.getFolderById(props().getProperty('SOURCE_LIBRARY_ID')),f=path(root,[r.year,'Grade_'+r.grade,r.subject,r.assessment_type,r.language,r.paper_type]),p=fetchFile(r.paper_url,r.paper_file_type),m=fetchFile(r.memo_url,r.memo_file_type);save(f,p,'Paper_'+name(r.paper_url,r.paper_file_type));save(f,m,'Memo_'+name(r.memo_url,r.memo_file_type));update(s,r._row,{status:'DOWNLOADED',source_folder_url:f.getUrl(),notes:'Paper and memo verified'});ok++}catch(x){update(s,r._row,{status:'DOWNLOAD_FAILED',notes:String(x)});fail++}});return{processed:batch.length,downloaded:ok,failed:fail}})}
function fetchFile(u,t){let err='';for(let i=0;i<3;i++)try{const r=UrlFetchApp.fetch(String(u),{muteHttpExceptions:true,followRedirects:true});if(r.getResponseCode()<200||r.getResponseCode()>299)throw Error('HTTP '+r.getResponseCode());const b=r.getBlob(),x=b.getBytes();if(t==='ZIP'&&!(x[0]===80&&x[1]===75))throw Error('Invalid ZIP');if(t!=='ZIP'&&!(x[0]===37&&x[1]===80&&x[2]===68&&x[3]===70))throw Error('Invalid PDF');return b}catch(e){err=String(e);Utilities.sleep(1000)}throw Error(err)}
function path(f,parts){parts.forEach(n=>{const i=f.getFoldersByName(String(n).replace(/[\\/:*?"<>|]/g,'-'));f=i.hasNext()?i.next():f.createFolder(String(n).replace(/[\\/:*?"<>|]/g,'-'))});return f}
function save(f,b,n){const i=f.getFilesByName(n);if(!i.hasNext()){b.setName(n);f.createFile(b)}}
function name(u,t){let n=decodeURIComponent(String(u).split('/').pop().split('?')[0]).replace(/[\\/:*?"<>|]/g,'-');if(!/\.(pdf|zip)$/i.test(n))n+=t==='ZIP'?'.zip':'.pdf';return n}
function update(s,row,c){const h=s.getRange(1,1,1,s.getLastColumn()).getValues()[0].map(String);Object.keys(c).forEach(k=>{const i=h.indexOf(k);if(i>=0)s.getRange(row,i+1).setValue(c[k])})}
