function adminSummary(p){guard(p);const q=objects(tab(APP.Q,QH)),c=objects(tab(APP.C,CH)),o=objects(tab(APP.O,OH));return{queue:counts(q,'status'),catalog:{total:c.length,ready:c.filter(x=>x.zip_status==='READY').length,published:c.filter(x=>String(x.published).toUpperCase()==='TRUE').length},orders:counts(o,'pf_status'),system:health()}}
function adminAction(p){guard(p);if(p.action==='scan_start')return startScannerLinksImport();if(p.action==='scan_stop')return stopScannerLinksImport();if(p.action==='download')return runDownloadBatch();if(p.action==='bundles')return buildAllBundles();if(p.action==='publish'){const c=tab(APP.C,CH),x=objects(c).find(y=>y.sku===p.sku);if(!x||x.zip_status!=='READY')throw Error('ZIP not ready');update(c,x._row,{published:'TRUE'});return{published:p.sku}}throw Error('Unknown action')}
function guard(p){const token=props().getProperty('ADMIN_API_TOKEN');if(!token||p.token!==token)throw Error('Access denied')}
function counts(a,k){const o={};a.forEach(x=>o[x[k]||'BLANK']=(o[x[k]||'BLANK']||0)+1);return o}
