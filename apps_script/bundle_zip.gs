ll('');Object.keys(vals).forEach(k=>{const i=h.indexOf(k);if(i>=0)arr[i]=vals[k]});c.getRange(row,1,1,h.length).setValues([arr]);j.rows.forEach(r=>update(tab(APP.Q,QH),r._row,{status:'ZIP_READY'}));return{sku,type:j.type,zip:zf.getUrl()}}
