function buildAllBundles(){return lock('bundles',()=>{const rec=objects(tab(APP.Q,QH)).filter(x=>x.status==='DOWNLOADED'&&x.source_folder_url),jobs={};rec.forEach(r=>{[['Single Subject',[r.grade,r.subject,r.year]],['Single Year',[r.grade,'ALL',r.year]],['Master Bundle',[r.grade,r.subject,'2022+']],['Ultimate Bundle',[r.grade,'ALL','2022+']]].forEach(z=>{const k=z[0]+'|'+z[1].join('|');(jobs[k]=jobs[k]||{type:z[0],grade:r.grade,subject:z[1][1],range:z[1][2],rows:[]}).rows.push(r)})});const result=[];Object.values(jobs).forEach(j=>result.push(buildZip(j)));return{jobs:result.length,results:result}})}
