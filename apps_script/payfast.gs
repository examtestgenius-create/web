const OH=['order_id','sku','title','customer_email','amount_cents','pf_payment_id','pf_status','invoice_url','zip_url','timestamp','delivery_status','delivery_sent_at','admin_notes','raw_itn','last_error'];
function createCheckout(p){return lock('checkout',()=>{const item=objects(tab(APP.C,CH)).find(x=>x.sku===p.sku);if(!item||String(item.published).toUpperCase()!=='TRUE'||item.zip_status!=='READY'||!item.zip_url)throw Error('Product not available');if(!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(p.customer_email||''))throw Error('Valid email required');const pr=props(),id='SH-'+Utilities.getUuid().slice(0,12).toUpperCase(),data={merchant_id:pr.getProperty('PAYFAST_MERCHANT_ID'),merchant_key:pr.getProperty('PAYFAST_MERCHANT_KEY'),return_url:(pr.getProperty('PAYFAST_RETURN_URL')||'https://examtestpaper.co.za/success.html')+'?order='+id,cancel_url:pr.getProperty('PAYFAST_CANCEL_URL')||'https://examtestpaper.co.za/cancel.html',notify_url:pr.getProperty('PAYFAST_NOTIFY_URL'),email_address:p.customer_email,m_payment_id:id,amount:(Number(item.price_cents)/100).toFixed(2),item_name:String(item.title).slice(0,100)};data.signature=sign(data,pr.getProperty('PAYFAST_PASSPHRASE'));tab(APP.O,OH).appendRow([id,item.sku,item.title,p.customer_email,item.price_cents,'','PENDING','',item.zip_url,new Date(),'PENDING','','','','']);const host=(pr.getProperty('PAYFAST_MODE')||'SANDBOX')==='LIVE'?'https://www.payfast.co.za/eng/process':'https://sandbox.payfast.co.za/eng/process';return{ok:true,data:{order_id:id,url:host+'?'+param(data)}}})}
function handleItn(d){const o=objects(tab(APP.O,OH)).find(x=>x.order_id===d.m_payment_id);if(!o)return'OK';if(o.pf_status==='COMPLETE')return'OK';const good=d.payment_status==='COMPLETE'&&Math.abs(Number(d.amount_gross)-Number(o.amount_cents)/100)<.01&&String(d.signature).toLowerCase()===sign(Object.fromEntries(Object.entries(d).filter(([k])=>k!=='signature')),props().getProperty('PAYFAST_PASSPHRASE'));if(!good){update(tab(APP.O,OH),o._row,{pf_status:'ITN_FAILED',last_error:'Validation failed'});return'OK'}update(tab(APP.O,OH),o._row,{pf_status:'COMPLETE',pf_payment_id:d.pf_payment_id,delivery_status:'DELIVERY_SENT',delivery_sent_at:new Date(),raw_itn:JSON.stringify(d)});MailApp.sendEmail({to:o.customer_email,subject:'StudyHub order ready',htmlBody:`<p>Your payment is confirmed.</p><p><a href="${o.zip_url}">Download ZIP</a></p>`});return'OK'}
function orderStatus(id){const o=objects(tab(APP.O,OH)).find(x=>x.order_id===id);return o?{ok:true,data:{order_id:id,pf_status:o.pf_status,status:o.pf_status,zip_url:o.pf_status==='COMPLETE'?o.zip_url:'',invoice_url:o.pf_status==='COMPLETE'?o.invoice_url:''}}:{ok:false,error:'Not found'}}
function sign(d,pass){return Utilities.computeDigest(Utilities.DigestAlgorithm.MD5,param(d)+(pass?'&passphrase='+enc(pass):''),Utilities.Charset.UTF_8).map(b=>('0'+(b<0?b+256:b).toString(16)).slice(-2)).join('')}function param(d){return Object.keys(d).filter(k=>d[k]!==''&&d[k]!=null).map(k=>k+'='+enc(d[k])).join('&')}function enc(v){return encodeURIComponent(String(v)).replace(/%20/g,'+')}
